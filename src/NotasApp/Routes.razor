<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="ruta">
        <RouteView RouteData="ruta" DefaultLayout="typeof(MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <EstadoVacio Icono="ti-mood-empty" Texto="Página no encontrada" />
        </LayoutView>
    </NotFound>
</Router>
