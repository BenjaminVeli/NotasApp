<Window x:Class="NotasApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:NotasApp"
        Title="Mi espacio" Width="1200" Height="760" MinWidth="900" MinHeight="560"
        Background="#000000" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
    <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:Routes}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
