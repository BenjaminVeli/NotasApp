@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject ItemService Items
@inject CategoriaService Categorias
@inject ArchivoService Archivos
@inject ConexionService Conexion
@inject NavegacionService Navegacion
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="app">
    <aside class="sidebar">
        <div class="buscar" title="Búsqueda global (Ctrl+K)" role="button" @onclick="() => buscando = true">
            <i class="ti ti-search"></i> Buscar
            <kbd>Ctrl K</kbd>
        </div>

        <NavLink class="nv" ActiveClass="on" href="" Match="NavLinkMatch.All">
            <i class="ti ti-note" style="color:var(--yellow)"></i>Notas
            <span class="cuenta">@Cuenta(TipoItem.Nota)</span>
        </NavLink>
        <NavLink class="nv" ActiveClass="on" href="reuniones">
            <i class="ti ti-calendar" style="color:var(--accent)"></i>Reuniones
            <span class="cuenta">@Cuenta(TipoItem.Reunion)</span>
        </NavLink>
        <NavLink class="nv" ActiveClass="on" href="codigo" Match="NavLinkMatch.All">
            <i class="ti ti-code" style="color:var(--purple)"></i>Código
        </NavLink>

        <div class="seccion">
            Categorías
            <button class="icono icono-chico" title="Nueva categoría" @onclick="() => creandoCategoria = true"><i class="ti ti-plus"></i></button>
        </div>
        @* La @key cambia tras cada arrastre: Blazor vuelve a crear la lista (ver notas.sortable, revertir: false). *@
        <div class="categorias" @key="versionCategorias" @ref="listaCategorias" title="Arrastra para ordenar">
            @foreach (var c in categorias)
            {
                var l = Lenguajes.Obtener(c.Lenguaje);
                <NavLink @key="c.Id" class="nv" ActiveClass="on" href="@($"codigo/{c.Id}")" draggable="false">
                    <i class="ti @l.Icono" style="color:@l.Color"></i>@c.Nombre
                    @if (c.Archivos > 0) { <span class="cuenta">@c.Archivos</span> }
                </NavLink>
            }
        </div>

        <div class="pie-sidebar">
            <div class="estado @Conexion.Estado.ToString().ToLowerInvariant()" title="@TooltipEstado">
                <span class="punto"></span>@TextoEstado
            </div>
            <NavLink class="icono" ActiveClass="on" href="configuracion" title="Configuración">
                <i class="ti ti-settings"></i>
            </NavLink>
        </div>
    </aside>

    <main class="main">
        @Body
    </main>
</div>

@if (creandoCategoria)
{
    <FormCategoria AlCerrar="() => creandoCategoria = false" AlGuardar="CategoriaCreada" />
}

@if (buscando)
{
    <PaletaBusqueda AlCerrar="() => buscando = false" />
}

@code {
    private Dictionary<string, int> cuentas = [];
    private List<CategoriaResumen> categorias = [];
    private bool creandoCategoria, recrearSortable, buscando;
    private int versionCategorias;
    private ElementReference listaCategorias;
    private DotNetObjectReference<MainLayout>? referencia;
    private IJSObjectReference? sortable;

    protected override async Task OnInitializedAsync()
    {
        Items.Cambio += AlCambiar;
        Categorias.Cambio += AlCambiar;
        Archivos.Cambio += AlCambiar;
        Conexion.Cambio += AlCambiarConexion;
        Navegacion.Solicitud += Navegar;
        await Cargar();
    }

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (primera)
        {
            // Ruta pedida antes de que existiera la ventana (p. ej. clic en un aviso con la app oculta).
            if (Navegacion.TomarPendiente() is { } ruta) Navegar(ruta);
            referencia = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("notas.atajosGlobales", referencia,
                new Dictionary<string, string> { ["ctrl+k"] = nameof(AlternarBusqueda) });
        }
        else if (!recrearSortable) return;

        recrearSortable = false;
        if (sortable is not null) await sortable.InvokeVoidAsync("destroy");
        sortable = await JS.InvokeAsync<IJSObjectReference>("notas.sortable", listaCategorias, referencia,
            new { handle = (string?)null, draggable = ".nv", metodo = nameof(MoverCategoria), revertir = false });
    }

    private void Navegar(string ruta) => _ = InvokeAsync(() => Nav.NavigateTo(ruta));

    private async Task Cargar()
    {
        cuentas = await Items.ContarPendientesAsync();
        categorias = await Categorias.ListarAsync();
    }

    private string Cuenta(string tipo) => cuentas.TryGetValue(tipo, out var n) && n > 0 ? n.ToString() : "";

    private void AlCambiar() => _ = InvokeAsync(async () => { await Cargar(); StateHasChanged(); });
    private void AlCambiarConexion() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Ctrl+K: abre la búsqueda global (o la cierra si ya está abierta).</summary>
    [JSInvokable]
    public void AlternarBusqueda()
    {
        buscando = !buscando;
        StateHasChanged();
    }

    private void CategoriaCreada(Guid id)
    {
        creandoCategoria = false;
        Nav.NavigateTo($"codigo/{id}");
    }

    /// <summary>Llamado desde SortableJS al soltar una categoría en el sidebar.</summary>
    [JSInvokable]
    public async Task MoverCategoria(int desde, int hasta)
    {
        if (desde == hasta || desde >= categorias.Count || hasta >= categorias.Count) return;
        var movida = categorias[desde];
        categorias.RemoveAt(desde);
        categorias.Insert(hasta, movida);
        // SortableJS ya movió el nodo: se descarta la lista y se vuelve a crear en el orden nuevo.
        versionCategorias++;
        recrearSortable = true;
        StateHasChanged();
        await Categorias.ReordenarAsync(categorias.Select(c => c.Id).ToList());
    }

    private string TextoEstado => Conexion.Estado switch
    {
        EstadoConexion.EnLinea => "En línea",
        EstadoConexion.Sincronizando => "Sincronizando",
        _ => "Sin conexión",
    };

    private string TooltipEstado => !Conexion.Configurada
        ? "Neon no está configurado: los datos se guardan solo en este equipo"
        : Conexion.UltimoError ?? "Conectado a Neon";

    public async ValueTask DisposeAsync()
    {
        Items.Cambio -= AlCambiar;
        Categorias.Cambio -= AlCambiar;
        Archivos.Cambio -= AlCambiar;
        Conexion.Cambio -= AlCambiarConexion;
        Navegacion.Solicitud -= Navegar;
        try { if (sortable is not null) await sortable.InvokeVoidAsync("destroy"); }
        catch (JSDisconnectedException) { }
        referencia?.Dispose();
    }
}
